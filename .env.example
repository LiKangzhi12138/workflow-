ENV_FILE_PATH=.env
PUBLIC_HTTP_BIND_IP=0.0.0.0
PUBLIC_HTTP_PORT=80
MYSQL_HOST_BIND_IP=127.0.0.1
MYSQL_HOST_PORT=3306

MYSQL_DATABASE=workflow_platform
MYSQL_USER=workflow
MYSQL_PASSWORD=change_this_mysql_password
MYSQL_ROOT_PASSWORD=change_this_mysql_root_password

VITE_API_BASE_URL=/api
VITE_API_TIMEOUT_MS=600000
VITE_DEV_PROXY_TARGET=
VITE_DEV_SERVER_HOST=0.0.0.0
VITE_PREVIEW_HOST=0.0.0.0
VITE_DEV_SERVER_PORT=5173
VITE_DEV_OPEN=false

NGINX_SERVER_NAME=_
CLIENT_MAX_BODY_SIZE=1024m
JAVA_UPSTREAM_URL=http://service-java:8080

SERVER_ADDRESS=0.0.0.0
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/workflow_platform?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
SPRING_DATASOURCE_USERNAME=workflow
SPRING_DATASOURCE_PASSWORD=change_this_mysql_password
SPRING_DATASOURCE_HIKARI_MAX_POOL_SIZE=10
SPRING_DATASOURCE_HIKARI_MIN_IDLE=2
SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT=30000
SPRING_DATASOURCE_HIKARI_IDLE_TIMEOUT=600000
SPRING_DATASOURCE_HIKARI_MAX_LIFETIME=1800000

SESSION_TIMEOUT=8h
SESSION_COOKIE_NAME=WORKFLOWSESSION
SESSION_COOKIE_SAME_SITE=Lax
SESSION_COOKIE_SECURE=false
SERVER_TOMCAT_CONNECTION_TIMEOUT=600000
SPRING_MVC_ASYNC_REQUEST_TIMEOUT=600000
SPRING_SERVLET_MULTIPART_LOCATION=/opt/workflow-platform/storage/tmp/java-multipart

WORKFLOW_STORAGE_ROOT=/opt/workflow-platform/storage
WORKFLOW_MODEL_UPLOAD_DIR=/opt/workflow-platform/storage/model-uploads
WORKFLOW_MODEL_ROOT=/opt/workflow-platform/storage/models
WORKFLOW_VALIDATION_CACHE_ROOT=/opt/workflow-platform/storage/validation-cache
WORKFLOW_FEDERATED_MODEL_ROOT=/opt/workflow-platform/storage/federated-models

PYTHON_SERVICE_BASE_URL=http://service-python:8000
JAVA_CALLBACK_BASE_URL=http://service-java:8080
PYTHON_CALLBACK_SECRET=replace_with_a_long_random_secret
PYTHON_HTTP_CONNECT_TIMEOUT_MS=10000
PYTHON_HTTP_READ_TIMEOUT_MS=600000
DEFAULT_ALGORITHM_TYPE=YOLOv10
PYTHON_VALIDATION_OUTPUT_ROOT=/opt/workflow-platform/storage/python/results
PYTHON_VALIDATION_SAMPLE_ROOT=/opt/workflow-platform/storage/python/result-samples

MAX_UPLOAD_SIZE=1024MB
MAX_REQUEST_SIZE=1050MB
APP_ALLOWED_ORIGINS=
APP_ALLOWED_ORIGIN_PATTERNS=

PYTHON_SERVICE_HOST=0.0.0.0
PYTHON_SERVICE_PORT=8000
PYTHON_STORAGE_ROOT=/opt/workflow-platform/storage/python
PYTHON_JOB_STORE_FILE=/opt/workflow-platform/storage/python/jobs/jobs.json
PYTHON_LOG_ROOT=/opt/workflow-platform/logs/python
PYTHON_LOG_FILE=/opt/workflow-platform/logs/python/service-python.log
PYTHON_FILE_LOG_ENABLED=false
PYTHON_LOG_LEVEL=INFO
PY_JOB_TIMEOUT_SECONDS=7200
YOLO_CONFIDENCE_THRESHOLD=0.25
YOLO_MAX_IMAGES=1000

HOST_STORAGE_ROOT=/opt/workflow-platform/storage
HOST_MYSQL_DATA_ROOT=/opt/workflow-platform/mysql-data
