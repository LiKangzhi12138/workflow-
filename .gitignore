# Logs / temporary files
*.log
*.log.*
*.tmp
*.bak
*.swp
*~
**/logs/*
!**/logs/README.md
!**/logs/.gitkeep

# Docker and application runtime data
/.runtime/
/storage/dev/*
!/storage/dev/README.md
!/storage/dev/.gitkeep
/service-java/storage/*
!/service-java/storage/README.md
!/service-java/storage/.gitkeep
/service-python/app/storage/*
!/service-python/app/storage/README.md
!/service-python/app/storage/.gitkeep
**/mysql-data/

# Test runner bootstrap artifacts
/service-java/mockitoboot*.jar

# Local database files and database exports
*.db
*.db-journal
*.sqlite
*.sqlite3
/dump-*.sql

# Model/checkpoint files are intentionally not ignored globally.
# Runtime models, uploads, encrypted files, federated outputs, and validation
# artifacts are covered by .runtime/, storage/dev/, and app/storage/ above.
